#pragma code_page(65001)

#include <windows.h>
#include "version_macros.h"

// The icon is generated by scripts/make_icon.py; it carries eight sizes so the shell picks a
// crisp one for the tray, the taskbar and the large-icon views alike.
// Numeric id, matching kIconResource in commands.cpp. A symbolic name here would become a string
// resource name and LoadIcon(MAKEINTRESOURCE(1)) would quietly return NULL.
1 ICON "wintools.ico"

// The manifest is NOT embedded here: the linker already generates one, and a second copy in the
// resources fails the link with CVT1100 (duplicate MANIFEST resource). CMake passes app.manifest
// to the linker as /MANIFESTINPUT instead - see CMakeLists.txt.

VS_VERSION_INFO VERSIONINFO
    FILEVERSION WINTOOLS_VERSION_COMMA
    PRODUCTVERSION WINTOOLS_VERSION_COMMA
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04b0 = Unicode. Kept in ASCII on purpose: the version block is read
        // by the shell before any of our code runs, and a codepage slip here shows up as mojibake
        // in Explorer's properties dialog.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WinTools"
            VALUE "FileDescription", "Multi-monitor wallpaper, window layout and sticky notes"
            VALUE "FileVersion", WINTOOLS_VERSION_FILESTRING
            VALUE "InternalName", "WinTools"
            VALUE "OriginalFilename", "WinTools.exe"
            VALUE "ProductName", "WinTools"
            VALUE "ProductVersion", WINTOOLS_VERSION_FILESTRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
