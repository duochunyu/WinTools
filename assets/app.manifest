<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
      type="win32"
      name="WinTools"
      version="0.2.0.0"
      processorArchitecture="amd64"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Per-Monitor V2. The panel is a custom-drawn sheet laid out in 96-dpi design units and
        stencilled through a scaled GDI mapping mode, so text and borders are rasterised at the
        device size instead of being stretched from a 96-dpi bitmap - which is what a DPI-unaware
        process gets, and what made the panel soft on a 150% or 200% display.

        What it changes for the rest of the app: almost nothing, and that was checked rather than
        assumed. A DPI-unaware process only gets a scaled coordinate space when the *system* DPI is
        above 96, which requires the primary display to be scaled; this desktop scales its displays
        to 125% but keeps the primary at 100%, so capturing the same windows before and after this
        change produced identical rectangles. GetWindowRect, GetMonitorInfo and SetWindowPos still
        agree on the pixels the user sees, and window placement stays plain integer arithmetic.
      -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

</assembly>
