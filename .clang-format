# Microsoft style: 4-space indent, Allman braces, one statement per line.
# Chosen because this file sits next to Win32 samples and WIC docs all day; matching
# their shape keeps copy-paste from Microsoft Learn readable in this tree.
BasedOnStyle: Microsoft
Language: Cpp

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 110

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline

BreakBeforeBraces: Allman
PointerAlignment: Left
ReferenceAlignment: Left

AccessModifierOffset: -4
IndentAccessModifiers: false

AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true
ConstructorInitializerAllOnOneLineOrOnePerLine: true
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: Consecutive
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

IncludeBlocks: Preserve
SortIncludes: CaseSensitive
